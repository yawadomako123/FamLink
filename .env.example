# ---------------------------------------------------------------------------
# FamLink environment variables
#
# Copy to `.env.local` and fill in. NEVER commit `.env.local`.
# Only variables prefixed NEXT_PUBLIC_ are exposed to the browser — keep every
# secret below unprefixed.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection, used for ordinary application queries.
# Neon: the connection string containing "-pooler" in the host.
DATABASE_URL="postgresql://famlink:famlink_dev_password@localhost:5432/famlink"

# Direct/unpooled connection. REQUIRED and must NOT be the pooled URL:
# PgBouncer runs in transaction mode and silently breaks LISTEN/NOTIFY, which
# the realtime event stream depends on. Also used for migrations.
# Neon: the connection string WITHOUT "-pooler" in the host.
DATABASE_URL_UNPOOLED="postgresql://famlink:famlink_dev_password@localhost:5432/famlink"

# --- Authentication (Better Auth) ------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# --- Application -----------------------------------------------------------
# Public origin, used to build invitation links (https://famlink.app/join/CODE).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Maps ------------------------------------------------------------------
# MapLibre style URL. Defaults to a free OpenStreetMap raster style if unset,
# so the app runs with no map account. Swap for MapTiler/Protomaps in production.
NEXT_PUBLIC_MAP_STYLE_URL=""

# --- Voice and video calls (WebRTC) ----------------------------------------
# STUN is built in and free, and covers most home broadband. TURN relays media
# when no direct path exists — behind symmetric NAT, carrier-grade NAT (common
# on mobile networks) or a restrictive firewall. Without it roughly 15-20% of
# calls will not connect; FamLink says so in the UI rather than spinning.
# Any standard TURN service works (Cloudflare Calls, Twilio, coturn, ...).
# The local coturn from docker-compose. Swap the host for a hosted relay in
# production; the credential scheme is identical.
TURN_URL="turn:127.0.0.1:3478"

# Offer several transports at once. UDP is fastest; TCP and TLS on 443 are what
# get through firewalls that block everything else.
TURN_URLS="turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp"

# PREFERRED. Enables short-lived HMAC credentials so no long-lived secret is
# ever sent to a browser. Must match the relay's static-auth-secret.
TURN_STATIC_AUTH_SECRET="famlink_dev_turn_secret"

# Fallback only, for hosted providers that issue long-lived credentials.
# Leave blank when using TURN_STATIC_AUTH_SECRET above.
TURN_USERNAME=""
TURN_CREDENTIAL=""

# --- Email (password resets) -----------------------------------------------
# Without RESEND_API_KEY, reset emails print to the server console in
# development and throw in production rather than vanishing silently.
RESEND_API_KEY=""
EMAIL_FROM=""

# --- File storage (Vercel Blob, for avatars) -------------------------------
# Optional in development: without it, avatar uploads are disabled and FamLink
# falls back to generated initials avatars. Never expose this to the browser.
BLOB_READ_WRITE_TOKEN=""

# --- Firebase Cloud Messaging (FCM) ----------------------------------------
# For native browser push notifications on alerts and updates.
# You can get the NEXT_PUBLIC_ variables by adding a Web App in your Firebase console.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# From Firebase Project Settings -> Cloud Messaging -> Web Configuration
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# The full JSON string of your Firebase service account key (Settings -> Service Accounts)
FIREBASE_SERVICE_ACCOUNT_JSON=""
